[Unit]
Description=Vesper world server (canonical, headless)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=vesper
Group=vesper
WorkingDirectory=/opt/vesper
EnvironmentFile=/opt/vesper/.env
Environment=HOME=/home/vesper
ExecStartPre=/opt/vesper/kernel/guard.sh
ExecStartPre=-/bin/rm -f /opt/vesper/state/stop /opt/vesper/state/restart.flag
ExecStart=/usr/local/bin/godot --headless --path /opt/vesper -- --server
# Godot installs no signal handler: ExecStop drops a flag, the server checkpoints and exits 0, then Restart=always brings it back.
# systemd also runs ExecStop after the process exited on its own, so the flag is only dropped while the server is still alive.
ExecStop=/bin/sh -c '[ -n "$MAINPID" ] && kill -0 "$MAINPID" 2>/dev/null || exit 0; touch /opt/vesper/state/stop; n=0; while kill -0 "$MAINPID" 2>/dev/null && [ "$n" -lt 100 ]; do sleep 0.2; n=$((n+1)); done'
Restart=always
RestartSec=5
TimeoutStopSec=40
MemoryMax=1200M
Nice=5
StandardOutput=append:/var/log/vesper/server.log
StandardError=append:/var/log/vesper/server.log

[Install]
WantedBy=multi-user.target
